+/* ---------------------------------------------------------------------- */
+/* Extra symmetry groups: inversion (Ci), Cnv, and the real dihedral      */
+/* groups (RDn).                                                          */
+/*                                                                        */
+/* These live here rather than in plCurve so that a patched ridgerunner    */
+/* still links against an unmodified libplCurve. Everything used below is  */
+/* public API exported by the installed library.                          */
+/*                                                                        */
+/* Two properties of that library shape all of this.                       */
+/*                                                                        */
+/* First, plc_symmetrize averages each orbit as                            */
+/*                                                                        */
+/*     (1/n) sum_i  sym[inverse[i]]->transform * L[ sym[i]->target ]       */
+/*                                                                        */
+/* so the inverse table is load-bearing, not decoration. Leaving it at     */
+/* calloc's zeros applies the identity where g^-1 belongs, which averages  */
+/* the wrong points and quietly deforms the curve while still reporting a  */
+/* clean build.                                                            */
+/*                                                                        */
+/* Second, plc_build_symmetry has NO distance tolerance. It maps each      */
+/* vertex with the bare matrix, takes the nearest vertex to the image, and */
+/* fails only when two vertices claim the same target. A curve far from    */
+/* symmetric can therefore yield a perfectly injective but entirely wrong  */
+/* vertex map. Its own comment gives the real validity condition -- the    */
+/* curve must already be symmetric to within half an edge length -- so     */
+/* rr_symmetrize_and_report measures that BEFORE symmetrizing and warns.   */
+/* ---------------------------------------------------------------------- */
+
+static const double RR_PI = 3.14159265358979323846;
+
+/* plc_matrix_vector_multiply is exported by the library but not declared in
+   plCurve.h, so we do the multiply here rather than risk a mismatched
+   prototype. plc_matrix is double[3][3], row major. */
+static plc_vector rr_apply_matrix(plc_matrix *A,plc_vector v)
+{
+  return plc_build_vect((*A)[0][0]*v.c[0] + (*A)[0][1]*v.c[1] + (*A)[0][2]*v.c[2],
+			(*A)[1][0]*v.c[0] + (*A)[1][1]*v.c[1] + (*A)[1][2]*v.c[2],
+			(*A)[2][0]*v.c[0] + (*A)[2][1]*v.c[1] + (*A)[2][2]*v.c[2]);
+}
+
+/* Parse "x,y,z" into a non-degenerate vector. The trailing %c rejects
+   trailing junk instead of silently accepting a prefix. */
+static bool rr_parse_vector(const char *str,plc_vector *out)
+{
+  double x,y,z;
+  char tail;
+
+  if (str == NULL) { return false; }
+  if (sscanf(str,"%lf,%lf,%lf%c",&x,&y,&z,&tail) != 3) { return false; }
+
+  if (!isfinite(x) || !isfinite(y) || !isfinite(z)) { return false; }
+
+  *out = plc_build_vect(x,y,z);
+  return (isfinite(plc_norm(*out)) && plc_norm(*out) > 1e-12);
+}
+
+/* The component of ref perpendicular to axis, normalized. This is what fixes
+   where the first mirror plane (Cnv) or first 2-fold axis (RDn) sits. A ref
+   parallel to the axis carries no angular information, so substitute an
+   arbitrary perpendicular rather than fail. */
+static plc_vector rr_perp_to(plc_vector ref,plc_vector axis)
+{
+  plc_vector perp;
+
+  perp = plc_vect_diff(ref,plc_scale_vect(plc_dot_prod(ref,axis),axis));
+
+  if (plc_norm(perp) < 1e-9) {
+    perp = plc_vect_diff(plc_build_vect(1,0,0),plc_scale_vect(axis.c[0],axis));
+  }
+  if (plc_norm(perp) < 1e-9) {
+    perp = plc_vect_diff(plc_build_vect(0,1,0),plc_scale_vect(axis.c[1],axis));
+  }
+
+  return plc_normalize_vect(perp,NULL);
+}
+
+/* Ci = {E, -I}: inversion. Order 2.
+
+   The centre is the ORIGIN, not the centroid, because plc_build_symmetry
+   applies the bare matrix. An off-centre curve has no inversion symmetry as
+   far as this code can tell, however symmetric its shape, so centre the
+   input first. Autoscale is safe: plc_scale multiplies coordinates, so it
+   scales about the origin and a centred curve stays centred.
+
+   Inversion is orientation reversing, so a curve with this symmetry is
+   isotopic to its own mirror image -- only an amphichiral knot or link can
+   have it at all. */
+static plc_symmetry_group *rr_inversion_group(plCurve *L)
+{
+  plc_symmetry_group *build;
+  plc_matrix A;
+  int i,j;
+
+  build = plc_symmetry_group_new(2);
+  if (build == NULL) { return NULL; }
+
+  plc_identity_matrix(&A);
+  build->sym[0] = plc_build_symmetry(&A,L);
+
+  plc_identity_matrix(&A);
+  for(i=0;i<3;i++) { for(j=0;j<3;j++) { A[i][j] = -A[i][j]; } }
+  build->sym[1] = plc_build_symmetry(&A,L);
+
+  build->inverse[0] = 0;
+  build->inverse[1] = 1;  /* inversion is its own inverse */
+
+  for(i=0;i<2;i++) {
+    if (build->sym[i] == NULL) { plc_symmetry_group_free(&build); return NULL; }
+  }
+
+  return build;
+}
+
+/* Cnv: n-fold rotation about axis, plus the n mirrors that CONTAIN the axis.
+   Order 2n. C2v is n = 2.
+
+   Mirror normals are perpendicular to the axis and pi/n apart -- pi/n and
+   not 2pi/n, because the plane with normal m is the same plane as the one
+   with normal -m, so n distinct planes fill half a turn. The group closes:
+   the product of two adjacent mirrors is the rotation between them. */
+static plc_symmetry_group *rr_cnv_group(plCurve *L,plc_vector axis,plc_vector ref,int n)
+{
+  plc_symmetry_group *build;
+  plc_matrix A,R;
+  plc_vector normal;
+  int i;
+
+  if (n < 2) { return NULL; }
+
+  build = plc_symmetry_group_new(2*n);
+  if (build == NULL) { return NULL; }
+
+  /* Rotations C_n^i occupy slots 0..n-1. */
+  plc_identity_matrix(&A);
+  build->sym[0] = plc_build_symmetry(&A,L);
+  for(i=1;i<n;i++) {
+    plc_rotation_matrix(axis,i*(2.0*RR_PI/(double)(n)),&A);
+    build->sym[i] = plc_build_symmetry(&A,L);
+  }
+
+  /* Mirrors sigma_v^i occupy slots n..2n-1. */
+  for(i=0;i<n;i++) {
+    plc_rotation_matrix(axis,i*(RR_PI/(double)(n)),&R);
+    normal = rr_apply_matrix(&R,ref);
+    plc_reflection_matrix(normal,&A);
+    build->sym[n+i] = plc_build_symmetry(&A,L);
+  }
+
+  /* C_n^i inverts to C_n^(n-i); every mirror is an involution. */
+  build->inverse[0] = 0;
+  for(i=1;i<n;i++) { build->inverse[i] = n - i; }
+  for(i=0;i<n;i++) { build->inverse[n+i] = n + i; }
+
+  for(i=0;i<2*n;i++) {
+    if (build->sym[i] == NULL) { plc_symmetry_group_free(&build); return NULL; }
+  }
+
+  return build;
+}
+
+/* RDn: the real dihedral group. An n-fold principal axis plus n 2-fold axes
+   PERPENDICULAR to it. Order 2n, every element a proper rotation, with no
+   mirrors and no inversion.
+
+   This is the Dn of molecular symmetry, and it is precisely what
+   ridgerunner's existing "D2" is not: that option calls plc_reflection_group
+   and yields a single mirror -- Cs, order 2. RD2 is the genuine order-4 D2,
+   the Klein four-group of half turns about three perpendicular axes.
+
+   The 2-fold axes are pi/n apart for the same reason the Cnv mirrors are: a
+   2-fold axis along u is the same axis as along -u. */
+static plc_symmetry_group *rr_dihedral_group(plCurve *L,plc_vector axis,plc_vector ref,int n)
+{
+  plc_symmetry_group *build;
+  plc_matrix A,R;
+  plc_vector u2;
+  int i;
+
+  if (n < 2) { return NULL; }
+
+  build = plc_symmetry_group_new(2*n);
+  if (build == NULL) { return NULL; }
+
+  /* Rotations about the principal axis occupy slots 0..n-1. */
+  plc_identity_matrix(&A);
+  build->sym[0] = plc_build_symmetry(&A,L);
+  for(i=1;i<n;i++) {
+    plc_rotation_matrix(axis,i*(2.0*RR_PI/(double)(n)),&A);
+    build->sym[i] = plc_build_symmetry(&A,L);
+  }
+
+  /* Half turns about the n perpendicular axes occupy slots n..2n-1. */
+  for(i=0;i<n;i++) {
+    plc_rotation_matrix(axis,i*(RR_PI/(double)(n)),&R);
+    u2 = rr_apply_matrix(&R,ref);
+    plc_rotation_matrix(u2,RR_PI,&A);
+    build->sym[n+i] = plc_build_symmetry(&A,L);
+  }
+
+  build->inverse[0] = 0;
+  for(i=1;i<n;i++) { build->inverse[i] = n - i; }
+  for(i=0;i<n;i++) { build->inverse[n+i] = n + i; }  /* half turns are involutions */
+
+  for(i=0;i<2*n;i++) {
+    if (build->sym[i] == NULL) { plc_symmetry_group_free(&build); return NULL; }
+  }
+
+  return build;
+}
+
+/* plc_coordplanes_reflection_group only checks the first two of its four
+   elements for a failed build (its loop runs i<2 over a group of order 4), so
+   it can return a group carrying NULL entries that crash the moment anything
+   walks it. Check properly before trusting any group. */
+static bool rr_group_complete(plc_symmetry_group *G)
+{
+  int i;
+
+  if (G == NULL) { return false; }
+  for(i=0;i<G->n;i++) { if (G->sym[i] == NULL) { return false; } }
+  return true;
+}
+
+/* Match a group spec that carries an order, e.g. "C3v" against "C%dv%n".
+
+   Plain sscanf is not enough. On "C3" or "C3h" the %d is assigned and only
+   then does the literal 'v' fail to match, so sscanf still returns 1 and a
+   naive == 1 test accepts the prefix: --Symmetry=C3 silently built C3v and
+   --Symmetry=Z/2 silently built Z/2Z. A trailing %c catches junk that follows
+   a fully matched pattern but not junk that replaces the closing literal. %n
+   is the fix: it is not counted in sscanf's return value, and it is reached
+   only if every literal before it matched, so requiring it to land on the
+   terminating NUL rejects both a short prefix and a long tail. */
+static bool rr_match_order(const char *spec,const char *pattern,int *order)
+{
+  int used = -1;
+
+  if (spec == NULL) { return false; }
+  if (sscanf(spec,pattern,order,&used) != 1) { return false; }
+  return (used == (int)strlen(spec));
+}
+
+/* A group cannot have more elements than the curve has vertices to permute,
+   and an unbounded p also overflows the 2*p element count and walks straight
+   into plCurve's unchecked callocs -- --Symmetry=C1000000000v hangs the
+   process rather than failing. */
+static void rr_check_order_fits(const char *spec,int p,plCurve *L)
+{
+  int verts = plc_num_verts(L);
+  char errmsg[1024];
+
+  if (p > verts) {
+    snprintf(errmsg,sizeof(errmsg),
+	     "Symmetry group %.256s asks for order parameter %d, but the link has only %d\n"
+	     "  vertices, so no such symmetry can permute them. Aborting run.\n",
+	     spec,p,verts);
+    FatalError(errmsg, __FILE__, __LINE__);
+  }
+}
+
+/* Reject a degenerate order parameter.
+
+   This guards a crash that predates the patch: plc_symmetry_group_new returns
+   NULL for n <= 0, and plc_rotation_group then writes build->sym[0] without
+   checking, so stock ridgerunner segfaults outright on --Symmetry=Z/0Z or
+   Z/-2Z. The fix belongs in plCurve, but validating here turns the segfault
+   into a message without touching the library. */
+static void rr_symmetry_bad_order(const char *spec,int p,int least)
+{
+  char errmsg[1024];
+
+  snprintf(errmsg,sizeof(errmsg),
+	   "Symmetry group %.256s has order parameter %d; at least %d is required. Aborting run.\n"
+	   "  For a single mirror use Cs. For one 2-fold axis use Z/2Z.\n",
+	   spec,p,least);
+  FatalError(errmsg, __FILE__, __LINE__);
+}
+
+/* Abort with a uniform message when a group could not be built. */
+static void rr_symmetry_build_failed(const char *name)
+{
+  char errmsg[1024];
+  snprintf(errmsg,sizeof(errmsg),
+	  "Couldn't build %s symmetry on input link. Aborting run.\n"
+	  "  Every vertex is matched to the nearest vertex of its image, and the build\n"
+	  "  fails when two vertices claim the same target. That means the input is not\n"
+	  "  symmetric enough -- it has to be symmetric to within half an edge length.\n"
+	  "  Symmetrize the input first, and check the axis and reference direction.\n",
+	  name);
+  FatalError(errmsg, __FILE__, __LINE__);
+}
+
+/* Symmetrize, and report honestly enough to catch a bad vertex map.
+
+   The error has to be measured BEFORE symmetrizing. Afterwards it is ~0 by
+   construction -- plc_symmetrize forces every orbit into agreement -- so a
+   check on the symmetrized curve always passes and can never detect the one
+   thing worth detecting. plc_build_symmetry has no distance tolerance: it maps
+   each vertex with the bare matrix, takes the nearest vertex to the image, and
+   fails only when two vertices claim the same target. A curve far from
+   symmetric can hand back a perfectly injective but entirely wrong map, which
+   symmetrizing then bakes in. plCurve's own comment gives the real validity
+   condition -- symmetric already to within half an edge length -- so that is
+   what gets checked, on the curve as supplied. */
+static void rr_symmetrize_and_report(plCurve *L,const char *name)
+{
+  double before,after,mean_edge;
+  int verts,order;
+
+  order = (L->G == NULL) ? 0 : L->G->n;
+  verts = plc_num_verts(L);
+  mean_edge = (verts > 0) ? plc_arclength(L,NULL)/(double)(verts) : 0.0;
+
+  before = plc_symmetry_group_check(L);
+  plc_symmetrize(L);
+  after = plc_symmetry_group_check(L);
+
+  logprintf("Built %s symmetry (order %d) on link. Error before symmetrizing %g, after %g.\n",
+	    name,order,before,after);
+
+  if (mean_edge > 0.0 && before > 0.5*mean_edge) {
+
+    logprintf("WARNING: the input was off symmetry by %g, more than half its mean edge\n",before);
+    logprintf("         length (%g). Vertices are matched to the nearest vertex of their\n",0.5*mean_edge);
+    logprintf("         image and the build fails only on a collision, so a curve this far\n");
+    logprintf("         off can produce a valid-looking but wrong vertex map, which\n");
+    logprintf("         symmetrizing has now baked in. Treat this run as suspect and\n");
+    logprintf("         symmetrize the input first.\n");
+
+  }
+}
